---
import BaseLayout from "./BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import ArticleCTA from "../components/ArticleCTA.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import HostingerGuideCTA from "../components/HostingerGuideCTA.astro";
import { categoryHref } from "../lib/categories";
import { jsonLd, SITE_NAME } from "../lib/json-ld";

interface Props {
  title: string;
  description: string;
  author: string;
  pubDate: string;
  updatedDate?: string;
  verifiedDate?: string;
  category: string;
  image: string;
  imageAlt: string;
  imageLink?: string;
  readingTime: number;
  ctaUrl?: string;
  ctaText?: string;
  ctaButtonLabel: string;
  ctaType: "afiliado" | "informativo";
  related: { title: string; href: string; category: string }[];
  slug: string;
}

const {
  title,
  description,
  author,
  pubDate,
  updatedDate,
  verifiedDate,
  category,
  image,
  imageAlt,
  imageLink,
  readingTime,
  ctaUrl,
  ctaText,
  ctaButtonLabel,
  ctaType,
  related,
  slug,
} = Astro.props;

const formattedDate = new Date(`${pubDate}T00:00:00`).toLocaleDateString(
  "pt-BR",
  {
    day: "2-digit",
    month: "long",
    year: "numeric",
  },
);

const formattedUpdated = updatedDate
  ? new Date(`${updatedDate}T00:00:00`).toLocaleDateString("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : undefined;

const formattedVerified = verifiedDate
  ? new Date(`${verifiedDate}T00:00:00`).toLocaleDateString("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : undefined;

// Dados estruturados (JSON-LD): Article + BreadcrumbList.
// Somente dados reais do artigo; sem Review, Product, notas ou avaliações.
const site = Astro.site!;
const pageUrl = new URL(Astro.url.pathname, site).href;
const coverUrl = new URL(image.replace(/\.webp$/i, ".jpg"), site).href;
const publisher = { "@type": "Organization", name: SITE_NAME, url: site.href };
const articleLd = jsonLd({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: [coverUrl],
  datePublished: pubDate,
  dateModified: updatedDate ?? pubDate,
  inLanguage: "pt-BR",
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  author:
    author === SITE_NAME
      ? publisher
      : { "@type": "Person", name: author },
  publisher,
});
const breadcrumbLd = jsonLd({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.href },
    { "@type": "ListItem", position: 2, name: "Artigos", item: new URL("/artigos/", site).href },
    { "@type": "ListItem", position: 3, name: category, item: new URL(categoryHref(category), site).href },
    { "@type": "ListItem", position: 4, name: title, item: pageUrl },
  ],
});
---

<BaseLayout
  title={`${title} — Radar F5 BR`}
  description={description}
  image={image}
  type="article"
>
  <script slot="head" type="application/ld+json" set:html={articleLd} />
  <script slot="head" type="application/ld+json" set:html={breadcrumbLd} />

  <div class="site-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>

        <span aria-hidden="true"> &gt; </span>

        <a href="/artigos/">Artigos</a>

        <span aria-hidden="true"> &gt; </span>

        <a href={categoryHref(category)}>{category}</a>
      </nav>

      <AdSlot position="top" />

      <h1 class="article-title">{title}</h1>

      <div class="meta-info">
        <span>
          Por
          <strong> {author}</strong>
        </span>

        <span>|</span>

        <time datetime={pubDate}>{formattedDate}</time>

        {
          formattedUpdated && (
            <>
              <span>|</span>
              <span class="updated-date">
                Atualizado em <time datetime={updatedDate}>{formattedUpdated}</time>
              </span>
            </>
          )
        }

        {
          formattedVerified && (
            <>
              <span>|</span>
              <span class="verified-date">
                Verificado em <time datetime={verifiedDate}>{formattedVerified}</time>
              </span>
            </>
          )
        }

        <span>|</span>

        <span id="reading-time">{readingTime} min de leitura</span>
      </div>
    </div>
  </div>

  <div class="container">
    <article class="main-article">
      <aside class="affiliate-notice" aria-label="Aviso sobre links de afiliados">
        <p>
          Este artigo pode conter links de afiliados. Se você comprar por eles,
          podemos receber uma comissão, sem custo extra para você.
          <a href="/sobre-nos/">Saiba mais</a>.
        </p>
      </aside>

      <picture class="featured-image">
        {
          imageLink ? (
            <a href={imageLink} rel="sponsored noopener" target="_blank">
              <img
                src={image}
                alt={imageAlt}
                width="1200"
                height="675"
                fetchpriority="high"
              />
            </a>
          ) : (
            <img
              src={image}
              alt={imageAlt}
              width="1200"
              height="675"
              fetchpriority="high"
            />
          )
        }
      </picture>

      {imageLink && <p class="featured-image__disclosure">Link de afiliado — podemos ganhar uma comissão.</p>}

      <section class="article-body">
        <slot />
      </section>

      <ArticleCTA
        url={ctaUrl}
        text={ctaText}
        buttonLabel={ctaButtonLabel}
        type={ctaType}
      />

      <HostingerGuideCTA currentSlug={slug} />
      <RelatedArticles items={related} />
    </article>
  </div>
</BaseLayout>
