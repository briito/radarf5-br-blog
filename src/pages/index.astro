---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CategoryNav from "../components/CategoryNav.astro";
const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Radar F5 BR — Reviews, Comparativos e Recomendações" description="Análises e comparações de produtos físicos e digitais para ajudar você a escolher com mais segurança e informação.">
  <section class="container hero-section"><div class="callout-box">
    <h1>Reviews, comparativos e recomendações para comprar melhor</h1>
    <p>Bem-vindo(a) ao <strong>Radar F5 BR</strong>.</p>
    <p>Pesquise produtos físicos e digitais, entenda vantagens e limitações e compare alternativas antes de decidir. Nossas análises distinguem informações verificadas de experiências práticas.</p>
  </div></section>
  <section class="container articles-grid"><CategoryNav /><h2>Artigos em destaque</h2>
    {articles.length === 0 ? <p class="empty-state">Estamos preparando os primeiros reviews, comparativos e recomendações. Explore as categorias e volte em breve!</p> : articles.map((article) => <ArticleCard title={article.data.title} description={article.data.description} category={article.data.category} image={article.data.image} imageAlt={article.data.imageAlt} href={`/artigos/${article.data.slug}/`} />)}
  </section>
</BaseLayout>
