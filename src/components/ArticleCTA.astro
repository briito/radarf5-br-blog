---
// Chamada no fim do artigo: link de afiliado (com aviso de comissão e
// rel="sponsored") ou link informativo, sem comissão. Só renderiza se houver
// url E texto — sem isso, nenhuma caixa vazia (ou genérica) aparece.
interface Props {
  url?: string;
  text?: string;
  buttonLabel: string;
  type: "afiliado" | "informativo";
}

const { url, text, buttonLabel, type } = Astro.props;

// `text` pode ter vários parágrafos separados por uma linha em branco (\n\n).
const paragraphs = (text ?? "").split("\n\n").filter(Boolean);
const isAffiliate = type === "afiliado";
---

{
  url && paragraphs.length > 0 && (
    <div class="cta-box">
      {paragraphs.map((paragraph) => (
        <p class="cta-box__text">{paragraph}</p>
      ))}

      <a
        href={url}
        class="btn-cta"
        rel={isAffiliate ? "sponsored noopener" : "noopener"}
        target="_blank"
      >
        {buttonLabel}
      </a>

      {isAffiliate && (
        <p class="cta-box__disclosure">
          Link de afiliado — podemos ganhar uma comissão.
        </p>
      )}
    </div>
  )
}
